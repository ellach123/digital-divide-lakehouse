  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How values are calculated",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "18pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Speeds are test-weighted averages: the sum of (tile average × tests) divided by the sum of tests, never an average of averages.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Speed tiles are assigned to countries and municipalities with an H3 spatial index.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Group and world values are weighted by tests (speed) or population (internet use).",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• A group value is shown only when reporting countries cover at least 90% of the group's population; otherwise it is hidden.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Low sample: a country quarter with fewer than 1,000 tests or a municipality quarter with fewer than 100 is flagged. Last-4-quarter speeds need at least 4,000 tests.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• \"Latest\" values pick the latest quarter or latest reliable year automatically.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
