/// Ookla speed per Dutch municipality, connection type and quarter; *_4q columns pool the latest 4 quarters.
table fct_speed_municipality_quarter
	lineageTag: 483cd9ef-eb7a-4259-8ea9-2147468344a2

	/// Ookla speed tests (Dutch municipalities).
	measure 'NL Speed Tests' = SUM ( fct_speed_municipality_quarter[tests] )
		formatString: #,0
		displayFolder: Speed (NL)
		lineageTag: ef63566b-b7c9-417b-b99f-88496538efb2

	/// Test-weighted mean download speed (Dutch municipalities): sum of speed x tests / sum of tests. Blank when fixed and mobile are mixed.
	measure 'NL Download Mbps' = IF ( HASONEVALUE ( fct_speed_municipality_quarter[conn_type] ), DIVIDE ( SUM ( fct_speed_municipality_quarter[sum_d_kbps_x_tests] ), SUM ( fct_speed_municipality_quarter[tests] ) ) / 1000 )
		formatString: #,0.0
		displayFolder: Speed (NL)
		lineageTag: dc79baaf-e790-4001-8b13-ca9256819eab

	/// Test-weighted mean upload speed (Dutch municipalities). Blank when fixed and mobile are mixed.
	measure 'NL Upload Mbps' = IF ( HASONEVALUE ( fct_speed_municipality_quarter[conn_type] ), DIVIDE ( SUM ( fct_speed_municipality_quarter[sum_u_kbps_x_tests] ), SUM ( fct_speed_municipality_quarter[tests] ) ) / 1000 )
		formatString: #,0.0
		displayFolder: Speed (NL)
		lineageTag: 79b1fdf3-8a37-4056-8160-9e0101b03225

	/// Test-weighted mean latency (Dutch municipalities). Blank when fixed and mobile are mixed.
	measure 'NL Latency ms' = IF ( HASONEVALUE ( fct_speed_municipality_quarter[conn_type] ), DIVIDE ( SUM ( fct_speed_municipality_quarter[sum_lat_ms_x_tests] ), SUM ( fct_speed_municipality_quarter[tests] ) ) )
		formatString: #,0
		displayFolder: Speed (NL)
		lineageTag: 7f399f2f-c7a8-4bf4-b7dd-c9dc89a7db6f

	/// TRUE when there are fewer than 100 tests per quarter (same rule as dbt is_low_sample).
	measure 'NL Low Sample' =
			VAR quarters = DISTINCTCOUNT ( fct_speed_municipality_quarter[quarter_start] )
			RETURN IF ( quarters > 0 && HASONEVALUE ( fct_speed_municipality_quarter[conn_type] ), [NL Speed Tests] < 100 * quarters )
		displayFolder: Speed (NL)
		lineageTag: 347cb93d-a405-4223-9a86-9330818998e0

	/// Tests in the 4 quarters up to the selected quarter. Needs exactly one quarter and connection type.
	measure 'NL Tests (4Q)' = IF ( HASONEVALUE ( fct_speed_municipality_quarter[quarter_start] ) && HASONEVALUE ( fct_speed_municipality_quarter[conn_type] ), SUM ( fct_speed_municipality_quarter[tests_4q] ) )
		formatString: #,0
		displayFolder: Speed (NL)
		lineageTag: ec38b5f6-f85d-4460-b26a-ca6f9f0c5f87

	/// Test-weighted download speed pooled over the 4 quarters up to the selected quarter (for sparse mobile data).
	measure 'NL Download Mbps (4Q)' = IF ( HASONEVALUE ( fct_speed_municipality_quarter[quarter_start] ) && HASONEVALUE ( fct_speed_municipality_quarter[conn_type] ), DIVIDE ( SUM ( fct_speed_municipality_quarter[sum_d_kbps_x_tests_4q] ), SUM ( fct_speed_municipality_quarter[tests_4q] ) ) / 1000 )
		formatString: #,0.0
		displayFolder: Speed (NL)
		lineageTag: a08db200-d2b7-44ce-8143-69935c3def9d

	/// Test-weighted upload speed pooled over 4 quarters.
	measure 'NL Upload Mbps (4Q)' = IF ( HASONEVALUE ( fct_speed_municipality_quarter[quarter_start] ) && HASONEVALUE ( fct_speed_municipality_quarter[conn_type] ), DIVIDE ( SUM ( fct_speed_municipality_quarter[sum_u_kbps_x_tests_4q] ), SUM ( fct_speed_municipality_quarter[tests_4q] ) ) / 1000 )
		formatString: #,0.0
		displayFolder: Speed (NL)
		lineageTag: d7f6cad4-d758-48c7-8d7b-0199334efbd1

	/// TRUE when the pooled 4 quarters still have fewer than 100 tests.
	measure 'NL Low Sample (4Q)' =
			VAR t = [NL Tests (4Q)]
			RETURN IF ( NOT ISBLANK ( t ), t < 100 )
		displayFolder: Speed (NL)
		lineageTag: 90d07593-feb1-4057-9189-8493f84c85cf

