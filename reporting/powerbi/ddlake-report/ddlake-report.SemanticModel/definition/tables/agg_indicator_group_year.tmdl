/// WDI indicators per world/region/income group and year, population-weighted in dbt, with coverage.
table agg_indicator_group_year
	lineageTag: 7cd2137d-b516-42fe-bd1f-57a7b98230fc

	/// Group value computed in dbt (not re-aggregated here). Blank when reporting countries cover < 90% of the group population.
	measure 'Group Value' = IF ( HASONEVALUE ( dim_group[group_key] ) && HASONEVALUE ( dim_indicator[indicator_code] ) && HASONEVALUE ( dim_year[Year] ), CALCULATE ( MAX ( agg_indicator_group_year[value] ), KEEPFILTERS ( agg_indicator_group_year[is_reliable] = TRUE () ) ) )
		formatString: #,0.0
		displayFolder: Indicators (groups)
		lineageTag: 641b80fb-6173-49a5-bf48-5ef275576803

	/// Group value even when coverage is below 90%. For tooltips only.
	measure 'Group Value (incl. low coverage)' = IF ( HASONEVALUE ( dim_group[group_key] ) && HASONEVALUE ( dim_indicator[indicator_code] ) && HASONEVALUE ( dim_year[Year] ), MAX ( agg_indicator_group_year[value] ) )
		formatString: #,0.0
		displayFolder: Indicators (groups)
		lineageTag: 3e851c11-5c49-4378-a7e7-1dba11153de1

	/// Share of the group population living in countries that report the indicator.
	measure 'Population Coverage' = IF ( HASONEVALUE ( dim_group[group_key] ) && HASONEVALUE ( dim_indicator[indicator_code] ) && HASONEVALUE ( dim_year[Year] ), MAX ( agg_indicator_group_year[population_coverage] ) )
		formatString: 0.0%
		displayFolder: Indicators (groups)
		lineageTag: 625f6e77-4061-4df0-8696-53c8fa9945ea

	/// Countries with a value for the indicator in that year.
	measure 'Countries Reporting' = IF ( HASONEVALUE ( dim_group[group_key] ) && HASONEVALUE ( dim_indicator[indicator_code] ) && HASONEVALUE ( dim_year[Year] ), MAX ( agg_indicator_group_year[countries_reporting] ) )
		formatString: #,0
		displayFolder: Indicators (groups)
		lineageTag: 5b5c790a-7043-4aeb-81d0-37f4f3794c31

	/// Internet users (% of population) of one group in the latest year whose reporting countries cover at least 90% of its population.
	measure 'Internet Users % (latest reliable)' =
			VAR reliable_rows = CALCULATETABLE ( agg_indicator_group_year, REMOVEFILTERS ( dim_year ), REMOVEFILTERS ( dim_indicator ), agg_indicator_group_year[indicator_code] = "IT.NET.USER.ZS", agg_indicator_group_year[is_reliable] = TRUE () )
			VAR y = MAXX ( reliable_rows, agg_indicator_group_year[year] )
			RETURN IF ( HASONEVALUE ( dim_group[group_key] ), MAXX ( FILTER ( reliable_rows, agg_indicator_group_year[year] = y ), agg_indicator_group_year[value] ) )
		formatString: #,0.0
		displayFolder: Latest
		lineageTag: ab9d5630-4031-42a3-995a-466b14b63865

	/// Year used by Internet Users % (latest reliable).
	measure 'Internet Users Year (latest reliable)' =
			VAR reliable_rows = CALCULATETABLE ( agg_indicator_group_year, REMOVEFILTERS ( dim_year ), REMOVEFILTERS ( dim_indicator ), agg_indicator_group_year[indicator_code] = "IT.NET.USER.ZS", agg_indicator_group_year[is_reliable] = TRUE () )
			VAR y = MAXX ( reliable_rows, agg_indicator_group_year[year] )
			RETURN IF ( HASONEVALUE ( dim_group[group_key] ), y )
		formatString: 0
		displayFolder: Latest
		lineageTag: c3099eb2-d29a-4884-b61f-2f64196cf5e5

