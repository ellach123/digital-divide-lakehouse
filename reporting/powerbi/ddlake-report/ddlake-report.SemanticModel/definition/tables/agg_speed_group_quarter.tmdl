/// Ookla speed per world/region/income group, connection type and quarter (additive sums).
table agg_speed_group_quarter
	lineageTag: 5fde80a6-5097-4e04-9c54-bbb3aaeaa316

	/// Tests in the group. Needs one classification (groups overlap across classifications).
	measure 'Group Tests' = IF ( HASONEVALUE ( dim_group[group_type] ), SUM ( agg_speed_group_quarter[tests] ) )
		formatString: #,0
		displayFolder: Speed (groups)
		lineageTag: 41ed5926-0877-48a4-9986-15db6dc11eac

	/// Test-weighted download speed of the group. Needs one classification and one connection type.
	measure 'Group Download Mbps' = IF ( HASONEVALUE ( dim_group[group_type] ) && HASONEVALUE ( agg_speed_group_quarter[conn_type] ), DIVIDE ( SUM ( agg_speed_group_quarter[sum_d_kbps_x_tests] ), SUM ( agg_speed_group_quarter[tests] ) ) / 1000 )
		formatString: #,0.0
		displayFolder: Speed (groups)
		lineageTag: bf4ab485-b9d1-4bf2-bff4-027e187930ab

	/// Test-weighted upload speed of the group.
	measure 'Group Upload Mbps' = IF ( HASONEVALUE ( dim_group[group_type] ) && HASONEVALUE ( agg_speed_group_quarter[conn_type] ), DIVIDE ( SUM ( agg_speed_group_quarter[sum_u_kbps_x_tests] ), SUM ( agg_speed_group_quarter[tests] ) ) / 1000 )
		formatString: #,0.0
		displayFolder: Speed (groups)
		lineageTag: d38148df-9bb9-4f95-82d5-70d20c042bf1

	/// Test-weighted latency of the group.
	measure 'Group Latency ms' = IF ( HASONEVALUE ( dim_group[group_type] ) && HASONEVALUE ( agg_speed_group_quarter[conn_type] ), DIVIDE ( SUM ( agg_speed_group_quarter[sum_lat_ms_x_tests] ), SUM ( agg_speed_group_quarter[tests] ) ) )
		formatString: #,0
		displayFolder: Speed (groups)
		lineageTag: 7d1bd4ed-cb38-47cf-9d15-d777939e6515

	/// Download speed over all units with tests, including those outside WDI.
	measure 'World Download Mbps' = CALCULATE ( [Group Download Mbps], REMOVEFILTERS ( dim_group ), dim_group[group_type] = "world" )
		formatString: #,0.0
		displayFolder: Speed (groups)
		lineageTag: 6ca30581-59c7-48bb-ba27-a59b742dae79

	/// High-income vs low-income download speed. Uses the selected income classification, else 'at the time'.
	measure 'HIC/LIC Download Ratio' =
			VAR classification = SELECTEDVALUE ( dim_group[group_type], "income_as_was" )
			VAR t = IF ( classification IN { "income_as_was", "income_current" }, classification, "income_as_was" )
			VAR hi = CALCULATE ( [Group Download Mbps], REMOVEFILTERS ( dim_group ), dim_group[group_type] = t, dim_group[group_code] = "HIC" )
			VAR lo = CALCULATE ( [Group Download Mbps], REMOVEFILTERS ( dim_group ), dim_group[group_type] = t, dim_group[group_code] = "LIC" )
			RETURN DIVIDE ( hi, lo )
		formatString: 0.0
		displayFolder: Speed (groups)
		lineageTag: 62fa7cf8-10a1-4fad-a4a1-9bfc5b62f15a

	/// Latest Ookla quarter loaded.
	measure 'Latest Quarter' =
			VAR q = CALCULATE ( MAX ( dim_quarter[quarter_start] ), REMOVEFILTERS ( dim_quarter ) )
			RETURN LOOKUPVALUE ( dim_quarter[Quarter], dim_quarter[quarter_start], q )
		displayFolder: Latest
		lineageTag: b78d54e3-2811-4b09-9b1f-99975434878b

	/// World fixed broadband download speed in the latest quarter.
	measure 'World Fixed Mbps (latest quarter)' =
			VAR q = CALCULATE ( MAX ( dim_quarter[quarter_start] ), REMOVEFILTERS ( dim_quarter ) )
			RETURN CALCULATE ( [World Download Mbps], REMOVEFILTERS ( dim_quarter ), dim_quarter[quarter_start] = q, REMOVEFILTERS ( dim_connection ), dim_connection[conn_type] = "fixed" )
		formatString: #,0.0
		displayFolder: Latest
		lineageTag: 5958a0f4-9633-4c1d-aa08-11cd3b8c2d8b

	/// High- vs low-income fixed download speed in the latest quarter.
	measure 'HIC/LIC Fixed Ratio (latest quarter)' =
			VAR q = CALCULATE ( MAX ( dim_quarter[quarter_start] ), REMOVEFILTERS ( dim_quarter ) )
			RETURN CALCULATE ( [HIC/LIC Download Ratio], REMOVEFILTERS ( dim_quarter ), dim_quarter[quarter_start] = q, REMOVEFILTERS ( dim_connection ), dim_connection[conn_type] = "fixed" )
		formatString: 0.0
		displayFolder: Latest
		lineageTag: 9c51f015-739c-48d8-9220-142ec440238b

