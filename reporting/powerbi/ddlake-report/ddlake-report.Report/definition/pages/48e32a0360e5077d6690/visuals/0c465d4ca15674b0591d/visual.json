          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Limitations",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "18pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Ookla tests are run by users who choose to test, so they describe tested connections, not all households.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Speed data cover only 8 quarters; long-run speed trends are not available.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Natural Earth boundaries are de facto. Tests can be attributed to an area whose economic data describe a different population (for example West Bank and Gaza).",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Some units (such as Somaliland) have speed data but no World Bank indicators.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Changes in income classification move countries between groups and can shift group values without any real change.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Recent internet-use values are incomplete: 2025 is hidden because coverage is below 90%.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
