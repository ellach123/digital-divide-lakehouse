/// Ookla speed per country, connection type and quarter (additive sums).
table fct_speed_country_quarter
	lineageTag: c74b17cd-1788-422c-b485-daca6925d6c2

	/// Ookla speed tests (countries).
	measure 'Speed Tests' = SUM ( fct_speed_country_quarter[tests] )
		formatString: #,0
		displayFolder: Speed (countries)
		lineageTag: 048a6b55-e0ef-4904-9c63-256a457b6261

	/// Test-weighted mean download speed (countries): sum of speed x tests / sum of tests. Blank when fixed and mobile are mixed.
	measure 'Download Mbps' = IF ( HASONEVALUE ( fct_speed_country_quarter[conn_type] ), DIVIDE ( SUM ( fct_speed_country_quarter[sum_d_kbps_x_tests] ), SUM ( fct_speed_country_quarter[tests] ) ) / 1000 )
		formatString: #,0.0
		displayFolder: Speed (countries)
		lineageTag: 9c583cfa-7189-471d-b15c-4b96caa4d9c5

	/// Test-weighted mean upload speed (countries). Blank when fixed and mobile are mixed.
	measure 'Upload Mbps' = IF ( HASONEVALUE ( fct_speed_country_quarter[conn_type] ), DIVIDE ( SUM ( fct_speed_country_quarter[sum_u_kbps_x_tests] ), SUM ( fct_speed_country_quarter[tests] ) ) / 1000 )
		formatString: #,0.0
		displayFolder: Speed (countries)
		lineageTag: 339bf763-8fb1-4b84-b0a2-d58ec0ef0db5

	/// Test-weighted mean latency (countries). Blank when fixed and mobile are mixed.
	measure 'Latency ms' = IF ( HASONEVALUE ( fct_speed_country_quarter[conn_type] ), DIVIDE ( SUM ( fct_speed_country_quarter[sum_lat_ms_x_tests] ), SUM ( fct_speed_country_quarter[tests] ) ) )
		formatString: #,0
		displayFolder: Speed (countries)
		lineageTag: 62fba7bf-d299-464c-bd00-bb7166767664

	/// TRUE when there are fewer than 1000 tests per quarter (same rule as dbt is_low_sample).
	measure 'Low Sample' =
			VAR quarters = DISTINCTCOUNT ( fct_speed_country_quarter[quarter_start] )
			RETURN IF ( quarters > 0 && HASONEVALUE ( fct_speed_country_quarter[conn_type] ), [Speed Tests] < 1000 * quarters )
		displayFolder: Speed (countries)
		lineageTag: acb59a7e-a6cc-4853-827b-defd4437c165

	/// Fixed broadband tests in the latest 4 quarters.
	measure 'Fixed Tests (last 4Q)' =
			VAR q = CALCULATE ( MAX ( dim_quarter[quarter_start] ), REMOVEFILTERS ( dim_quarter ) )
			RETURN CALCULATE ( [Speed Tests], REMOVEFILTERS ( dim_quarter ), dim_quarter[quarter_start] > EDATE ( q, -12 ), REMOVEFILTERS ( dim_connection ), dim_connection[conn_type] = "fixed" )
		formatString: #,0
		displayFolder: Latest
		lineageTag: eb821f95-31b7-4199-a00f-54a27d111266

	/// Fixed download speed over the latest 4 quarters; blank below 4,000 tests (the 1,000-per-quarter low-sample rule).
	measure 'Fixed Download Mbps (last 4Q)' =
			VAR q = CALCULATE ( MAX ( dim_quarter[quarter_start] ), REMOVEFILTERS ( dim_quarter ) )
			VAR tests = [Fixed Tests (last 4Q)]
			RETURN IF ( tests >= 4000, CALCULATE ( [Download Mbps], REMOVEFILTERS ( dim_quarter ), dim_quarter[quarter_start] > EDATE ( q, -12 ), REMOVEFILTERS ( dim_connection ), dim_connection[conn_type] = "fixed" ) )
		formatString: #,0.0
		displayFolder: Latest
		lineageTag: a658f1b0-32ad-46f8-8f98-b6777b4da0c2

