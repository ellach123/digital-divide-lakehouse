/// One row per country and year: WDI indicators side by side plus yearly Ookla speed.
table mart_country_year
	lineageTag: b5a95be3-07a6-4c9b-8cc0-f85a33dcd322

	/// Population of the countries in context.
	measure 'Total Population' = SUM ( mart_country_year[Population] )
		formatString: #,0
		displayFolder: Indicators (countries)
		lineageTag: 0ca17c79-2d74-4f61-adb7-8d69b14e94fc

	/// Population-weighted share of internet users over the countries that report it.
	measure 'Internet Users % (weighted)' =
			VAR reporting = FILTER ( mart_country_year, NOT ISBLANK ( mart_country_year[Internet users (%)] ) && NOT ISBLANK ( mart_country_year[Population] ) )
			RETURN DIVIDE ( SUMX ( reporting, mart_country_year[Internet users (%)] * mart_country_year[Population] ), SUMX ( reporting, mart_country_year[Population] ) )
		formatString: #,0.0
		displayFolder: Indicators (countries)
		lineageTag: 2ed97b26-5304-4867-a3ab-28b1648d4ab7

	/// Population-weighted GDP per capita (PPP) over the countries that report it.
	measure 'GDP per Capita PPP (weighted)' =
			VAR reporting = FILTER ( mart_country_year, NOT ISBLANK ( mart_country_year[GDP per capita, PPP] ) && NOT ISBLANK ( mart_country_year[Population] ) )
			RETURN DIVIDE ( SUMX ( reporting, mart_country_year[GDP per capita, PPP] * mart_country_year[Population] ), SUMX ( reporting, mart_country_year[Population] ) )
		formatString: #,0
		displayFolder: Indicators (countries)
		lineageTag: 2de04245-1c09-4b74-92a9-322a5911ed9f

